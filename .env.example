# Copy to .env for local development. Never commit .env.
APP_ORIGIN=http://localhost:3000
PORT=3000
AUTH_MODE=demo
# Required for an internet-hosted demo: a random code with 12+ characters.
DEMO_ACCESS_CODE=
DB_PATH=data/common-ground.sqlite
RETENTION_DAYS=30
PRIVACY_CONTACT=
# Set 1 ONLY behind the single trusted reverse proxy in compose.yaml.
TRUST_PROXY=0
# Hosting only: bare domain without https:// (used by Caddy).
SITE_DOMAIN=

# CAS integration: activate only after the UPPA service and student claim are confirmed.
CAS_BASE_URL=https://sso.univ-pau.fr/cas
IDENTITY_SECRET=
CAS_STUDENT_ATTRIBUTE=
CAS_STUDENT_VALUES=
